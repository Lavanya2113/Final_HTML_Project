.navbar{
    background: rgba(41, 63, 116, 0.65);
    width: 100%;
    height: 70px;
    justify-items: center;
}
.nav_ul{
    display: flex;
    
}
.nav_listitem{
    color: #f8fafc ;
}
.nav_anchor{
    margin-top: 15px;
    justify-content: space-between;
    text-decoration: none;
    list-style: none;
    color: #f8fafc;
    padding:10px 30px;
    border-radius: 5px;
    transition: all 0.3s ease;    
}
.nav_anchor:hover{
background: linear-gradient(
    to right,
    rgba(13, 161, 225, 0.25),
    rgba(157, 190, 205, 0.25)
);
color: #bfcfd6;
}